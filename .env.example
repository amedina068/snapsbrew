# Snapsbrew configuration.
# Copy this file to .env, then run `php artisan key:generate`.
# For Docker, start from .env.docker.example instead.

APP_NAME=Snapsbrew
# Safe values for a public server. For local development, set APP_ENV=local
# and APP_DEBUG=true. Never set APP_DEBUG=true on a public server, because the
# error pages then show the configuration and the stack traces.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The public URL of this instance. Links, API docs and signed URLs use it.
APP_URL=http://localhost:8000
# The addresses (IP or CIDR, comma separated) of each proxy in front of the
# app. The app reads the client IP from the X-Forwarded-For header only when
# the request comes from one of them. If Cloudflare is in front, add its ranges
# from https://www.cloudflare.com/ips/.
# TRUSTED_PROXIES=
# Hosts the app ran on before APP_URL, comma separated. Embedded form URLs that
# the app signed on one of these hosts keep working.
APP_PREVIOUS_URLS=

# Logging. Rollbar joins the "stack" channel only when ROLLBAR_TOKEN is set.
LOG_CHANNEL=stack
LOG_LEVEL=debug
ROLLBAR_TOKEN=

# Database. SQLite works for local development. Production uses MySQL 8.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=snapsbrew
# DB_USERNAME=snapsbrew
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# CACHE_PREFIX=
FILESYSTEM_DRIVER=local
# Use "redis" with Horizon in production. "sync" renders in the request.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# If this is not set, the session cookie is secure when APP_URL starts with
# https. Set false only to serve an https APP_URL over plain http.
# SESSION_SECURE_COOKIE=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=

# Horizon. Only the owner of the instance can open /horizon.
HORIZON_PREFIX=snapsbrew_horizon:
# HORIZON_NAME=
# HORIZON_DOMAIN=
HORIZON_PATH=horizon
# The number of queue workers. Empty means 10 in production and 3 in local.
# Keep it in line with the CONCURRENT value of Browserless.
# HORIZON_MAX_PROCESSES=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Amazon SES: set MAIL_MAILER=ses (or ses-v2). An empty AWS_SES_* key falls
# back to the matching AWS_* key below.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
AWS_SES_CONFIGURATION_SET=

# Media storage. The rendered images go to the MEDIA_DISK disk: "public"
# (local storage/app/public), "s3", "spaces" or "r2".
MEDIA_DISK=public
QUEUE_CONVERSIONS_BY_DEFAULT=true
IMAGE_DRIVER=gd
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_URL=

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# Renderer. "browserless" posts the snap HTML to a Browserless service (the
# Docker setup uses it). "browsershot" starts a local Chrome through Node and
# Puppeteer for each render.
RENDER_DRIVER=browsershot

# The free public tools (POST /api/v1/tools/*). The app has no tools web
# pages. A marketing site can call these endpoints from the browser. They
# return 404 until SNAPSBREW_FREE_TOOLS_ENABLED is true.
SNAPSBREW_FREE_TOOLS_ENABLED=false
# The user that owns the screenshots of the free screenshot tool.
SNAPSBREW_FREE_TOOLS_USER_ID=1
# The uuid of the one template that each template tool renders. A tool
# without a template returns 503.
SNAPSBREW_FREE_TOOLS_CERTIFICATE_TEMPLATE=
SNAPSBREW_FREE_TOOLS_TESTIMONIAL_TEMPLATE=
SNAPSBREW_FREE_TOOLS_TWITTER_GRAPH_TEMPLATE=
# The limits for one IP on all free tools together.
SNAPSBREW_FREE_TOOLS_REQUESTS_PER_MINUTE_PER_IP=5
SNAPSBREW_FREE_TOOLS_REQUESTS_PER_DAY_PER_IP=50

# The maximum number of invitation mails that one company can send in 24 hours.
SNAPSBREW_INVITATIONS_PER_COMPANY_PER_DAY=20

# The maximum number of data rows in one spreadsheet import. Each row queues one snap.
SNAPSBREW_IMPORT_MAX_ROWS=5000

BROWSERLESS_URL=
BROWSERLESS_TOKEN=
# Seconds for one render attempt. The renderer tries 3 times. Keep 3 times this
# value below the Horizon job timeout of 60 seconds.
BROWSERLESS_TIMEOUT=15
# BROWSERSHOT_NODE_PATH=
# BROWSERSHOT_NPM_PATH=
# A remote Chrome for the screenshot feature, as host:port. Empty starts a
# local Chrome.
BROWSERSHOT_INSTANCE=

# Accounts. REGISTRATION_ENABLED gives the default registration mode: false is
# invite only, true is open. The owner can change the mode in Admin > Settings,
# and that value wins. Create the first account on the /setup page, or with
# `php artisan snapsbrew:install`.
REGISTRATION_ENABLED=false

# Previews (REST and MCP) show a "PREVIEW" overlay when this is true.
SNAPSBREW_PREVIEW_WATERMARK=true

# The email that the API docs show for questions. Empty shows MAIL_FROM_ADDRESS.
SNAPSBREW_SUPPORT_EMAIL=
# Your privacy policy and terms of service. llms.txt links them when they are set.
SNAPSBREW_PRIVACY_URL=
SNAPSBREW_TERMS_URL=

# Requests per minute for the public embedded form routes. The per IP limits
# need TRUSTED_PROXIES when a reverse proxy is in front of the app.
SNAPSBREW_EMBEDDED_FORM_SUBMITS_PER_IP=10
SNAPSBREW_EMBEDDED_FORM_SUBMITS_PER_FORM=60
SNAPSBREW_EMBEDDED_FORM_VIEWS_PER_IP=60
SNAPSBREW_EMBEDDED_FORM_VIEWS_PER_FORM=600

# Requests per minute from one IP to the public signed URL route. Link preview
# crawlers fetch og:image URLs in bursts, so keep this value high. It also needs
# TRUSTED_PROXIES when a reverse proxy is in front of the app.
SNAPSBREW_SIGNED_URL_REQUESTS_PER_IP=600

# Seconds that the signed URL route caches the valid keys of a user. A change
# to a key in the app clears the cache at once.
SNAPSBREW_SIGNED_URL_KEY_CACHE_SECONDS=60

# Optional social cards for the docs pages, rendered by this instance through
# a signed URL. Set a signed-URL key (Account > Developers) and the uuid of a
# template with "badge", "headline" and "subhead" layers. Empty uses a static image.
SNAPSBREW_SIGNED_URL_KEY=
SNAPSBREW_OG_TEMPLATE=
SNAPSBREW_OG_BASE="${APP_URL}"

# MCP server. When MCP_ENABLED is false, the app registers no /mcp route and
# no OAuth route. The REST API keeps working.
MCP_ENABLED=true

# MCP OAuth 2.0 (the connector path). Passport signs tokens with an RSA key
# pair. `php artisan snapsbrew:install` runs `php artisan passport:keys` when
# the keys are missing. You can also set the two variables below and deploy
# no key files.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# PASSPORT_CONNECTION=

# Where an authorization code may be delivered. Comma separated, scheme and host
# only. `POST /oauth/register` is open, so this list is what stops a client from
# pointing the callback at a host you do not accept. Add `http://localhost` to
# develop a connector on this machine.
MCP_REDIRECT_DOMAINS=https://claude.ai,https://claude.com

# Private-use URI schemes that native desktop clients call back on, for example
# `cursor`. A scheme here is accepted with any host.
MCP_CUSTOM_SCHEMES=

# The OAuth authorization server that the MCP discovery document names. Empty
# uses this instance.
# MCP_AUTHORIZATION_SERVER=
