<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite peaks at 133 MB and the Herd PHP 8.4 CLI loads no php.ini,
            so the default limit of 128 MB stops the run. Every `php artisan test`
            died in SnapImportCsvTest, which allocates a 12 MB fixture.

            This line raises the ceiling. It does not lower the cost. If the peak
            climbs again, read what was added to the process, not what asks for
            the memory.
        -->
        <ini name="memory_limit" value="512M"/>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <!-- The database is declared with `env force="false"`, not `server`.
             PHPUnit writes a `server` entry unconditionally, so a `server` here
             made DB_CONNECTION unsettable from the environment and every test
             that self-skips outside MySQL reported "skipped" on every machine
             and never ran. `force="false"` keeps SQLite as the default and lets
             `DB_CONNECTION=mysql DB_DATABASE=<schema> vendor/bin/phpunit` select
             a real MySQL lane. Continuous integration sets both explicitly at the
             job level, so its behaviour does not change. -->
        <env name="DB_CONNECTION" value="sqlite" force="false"/>
        <env name="DB_DATABASE" value=":memory:" force="false"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
