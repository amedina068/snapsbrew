# Settings for `docker compose`. Copy this file to .env.
# docker-compose.yml sets the database, Redis and renderer hosts itself.
# Every other variable of .env.example works here too.

APP_NAME=Snapsbrew
APP_ENV=production
APP_DEBUG=false
# Generate a key: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# The URL people open. When a template loads an image from this instance,
# the Browserless container must also reach this URL.
APP_URL=http://localhost:8080
# The host port of the web container.
APP_PORT=8080
# The host interface of that port. The default 127.0.0.1 takes traffic only
# from the host, for example from a reverse proxy. Set 0.0.0.0 to take traffic
# from other hosts.
# APP_BIND=127.0.0.1
# docker-compose.image.yml only: the tag of the published image.
# SNAPSBREW_VERSION=latest
# The addresses (IP or CIDR, comma separated) of each proxy in front of the
# app. The app reads the client IP from the X-Forwarded-For header only when
# the request comes from one of them. For a reverse proxy on this host, use the
# gateway address of the Docker network, for example 172.18.0.1. If Cloudflare
# is in front, also add its ranges from https://www.cloudflare.com/ips/.
# TRUSTED_PROXIES=

DB_DATABASE=snapsbrew
DB_USERNAME=snapsbrew
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Generate a token: openssl rand -hex 24
BROWSERLESS_TOKEN=

REGISTRATION_ENABLED=false
MCP_ENABLED=true
SNAPSBREW_PREVIEW_WATERMARK=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# The rendered images stay in the "storage" volume.
MEDIA_DISK=public
