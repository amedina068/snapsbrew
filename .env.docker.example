# Settings for `docker compose`. Copy this file to .env.
#
# Each setting is optional. With no .env file, the stack runs one container
# with SQLite on http://localhost:8080. Every variable of .env.example works
# here too.

# The URL that people open. The default is http://localhost:8080.
# APP_URL=https://images.example.com

# Set a domain to get automatic HTTPS from Caddy in the container. Then
# APP_URL is https://<domain>. Publish the ports 80 and 443 of the container
# (add "80:80" and "443:443" to the ports of the web service), and point the
# DNS record of the domain to this host.
# APP_DOMAIN=images.example.com

# The host port of the web container.
# APP_PORT=8080
# The host interface of that port. The default 127.0.0.1 takes traffic only
# from the host, for example from a reverse proxy. Set 0.0.0.0 to take traffic
# from other hosts.
# APP_BIND=127.0.0.1

# docker-compose.image.yml only: the tag of the published image.
# SNAPSBREW_VERSION=latest

# The addresses (IP or CIDR, comma separated) of each proxy in front of the
# app. The app reads the client IP from the X-Forwarded-For header only when
# the request comes from one of them. For a reverse proxy on this host, use the
# gateway address of the Docker network, for example 172.18.0.1. If Cloudflare
# is in front, also add its ranges from https://www.cloudflare.com/ips/.
# With APP_DOMAIN, the default is 127.0.0.1 (the Caddy of the container).
# TRUSTED_PROXIES=

# REGISTRATION_ENABLED=false
# MCP_ENABLED=true

# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com

# ---------------------------------------------------------------------------
# MySQL, Redis, Horizon and Browserless
#
# Remove the comment marks of this block to use the "mysql" profile.
# Generate each secret with: openssl rand -hex 24
# ---------------------------------------------------------------------------
# COMPOSE_PROFILES=mysql
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=snapsbrew
# DB_USERNAME=snapsbrew
# DB_PASSWORD=
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# RENDER_DRIVER=browserless
# BROWSERLESS_URL=http://browserless:3000
# Browserless runs in its own container, so it reads the images and the fonts
# of a snap from the web container.
# RENDER_ASSET_URL=http://web:8080
# BROWSERLESS_TOKEN=
