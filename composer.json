{
    "name": "snapsbrew/snapsbrew",
    "type": "project",
    "description": "A self-hosted app that renders images and PDFs from templates, with a REST API and an MCP server.",
    "keywords": [
        "image-generation",
        "templates",
        "mcp",
        "laravel"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.0",
        "bacon/bacon-qr-code": "^3.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/fortify": "^1.19",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.47",
        "laravel/mcp": "^1.2.1",
        "laravel/passport": "^13.7",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "phpoffice/phpspreadsheet": "^5.9",
        "picqer/php-barcode-generator": "^3.2",
        "rollbar/rollbar-laravel": "^8.0",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-medialibrary": "^11.0",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "devizzent/cebe-php-openapi": "^1.1",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "api-docs": [
            "@php artisan api:export"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --parallel"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/horizon"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
